[Unit]
Description=Safe admin API
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=safe
Group=safe
WorkingDirectory=/opt/safe
EnvironmentFile=-/etc/safe/safe.env
ExecStart=/opt/safe/bin/safe admin
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
