# Copy to /etc/safe/safe.env or project .env — placeholders only, no real secrets.
CONFIG_FILE=/opt/safe/config/app.yml
ADMIN_PORT=8081
API_PORT=8080
CHAT_PORT=8082
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=safe
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=safe
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRE_HOURS=24
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
SAFEW_API_BASE_URL=https://api.safew.bot
# Comma-separated SafeW user IDs (developers bootstrap)
DEVELOPER_USER_IDS=
